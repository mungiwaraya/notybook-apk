# Disable directory browsing in css directory
Options -Indexes

# Prevent direct URL access to CSS files without local Referer
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?localhost [NC]
    RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?127\.0\.0\.1 [NC]
    RewriteCond %{HTTP_REFERER} !^http(s)?://.*\.github\.io [NC]
    RewriteRule \.css$ /inote/index.html [R=302,L]
</IfModule>
